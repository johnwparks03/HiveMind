# Copy to .env (gitignored) and fill in from the CDK stack outputs:
#   aws cloudformation describe-stacks --stack-name HiveMind --region us-east-1 --query "Stacks[0].Outputs" --output table
# Variables already set in the shell take precedence over this file.

# CDK output: UserPoolClientId
HIVEMIND_COGNITO_CLIENT_ID=

# CDK output: HttpApiUrl
HIVEMIND_CENTRAL_API_URL=

# Optional, defaults to us-east-1
# HIVEMIND_COGNITO_REGION=us-east-1
