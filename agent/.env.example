# Copy to .env (gitignored) and fill in from the CDK stack outputs:
#   aws cloudformation describe-stacks --stack-name HiveMind --region us-east-1 --query "Stacks[0].Outputs" --output table
# Variables already set in the shell take precedence over this file.

# CDK output: UserPoolClientId
HIVEMIND_COGNITO_CLIENT_ID=

# CDK output: HttpApiUrl
HIVEMIND_CENTRAL_API_URL=

# CDK output: WebSocketUrl (relay - lets teammates download files you've published)
HIVEMIND_RELAY_WS_URL=

# Optional, defaults to us-east-1
# HIVEMIND_COGNITO_REGION=us-east-1

# Local Bedrock (decided 2026-10-15, demo/MVP only — see CLAUDE.md): POST /ask and
# POST /files/{id}/tags/generate call Bedrock directly from the agent, so they need
# their own AWS credentials here. boto3 reads these standard env var names itself —
# no HIVEMIND_ prefix, no custom loading code. Use your own IAM user's access key
# (bedrock:InvokeModel on the model in CLAUDE.md's AWS section is enough); never a
# long-lived production key, and never commit real values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Only needed if your access key starts with ASIA (a temporary/SSO credential, not a
# permanent IAM user key starting with AKIA) — those require this third value, and
# expire, so they'll need refreshing periodically.
# AWS_SESSION_TOKEN=
