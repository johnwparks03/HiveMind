{
  "info": {
    "name": "HiveMind Agent",
    "description": "Interface A (frontend -> local agent): startup token, signup, login, logout, session. Run `01 Get startup token` first, and again after each agent restart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-HiveMind-Token",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "AGENT_URL",
      "value": "http://127.0.0.1:8420"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "test1@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd1"
    }
  ],
  "item": [
    {
      "name": "01 Get startup token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const t = pm.response.json().token;",
              "pm.test(\"token present\", () => pm.expect(t).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"token\", t);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          }
        ],
        "url": {
          "raw": "{{AGENT_URL}}/auth/token",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Run first, and again after every agent restart. Saves the startup token to the `token` variable."
      }
    },
    {
      "name": "02 No token is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error code unauthorized\", () => pm.expect(pm.response.json().error.code).to.eql(\"unauthorized\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/session",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "session"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "03 Bad origin is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"error code forbidden\", () => pm.expect(pm.response.json().error.code).to.eql(\"forbidden\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://evil.example"
          }
        ],
        "url": {
          "raw": "{{AGENT_URL}}/auth/token",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "04 Session (signed out)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"signed out\", () => { pm.expect(b.agent).to.eql(\"ok\"); pm.expect(b.signed_in).to.eql(false); pm.expect(b.email).to.eql(null); pm.expect(b.team).to.eql(null); pm.expect(b.relay).to.eql(\"disconnected\"); });",
              "pm.test(\"central reachable (needs HIVEMIND_CENTRAL_API_URL)\", () => pm.expect(b.central_reachable).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/session",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "session"
          ]
        }
      }
    },
    {
      "name": "05 Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"created\", () => pm.expect(pm.response.json().status).to.eql(\"created\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/signup",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Succeeds once per email. Change the `email` variable before re-running."
      }
    },
    {
      "name": "06 Signup duplicate",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"error code user_exists\", () => pm.expect(pm.response.json().error.code).to.eql(\"user_exists\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/signup",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Signup weak password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"error code password_policy\", () => pm.expect(pm.response.json().error.code).to.eql(\"password_policy\"));",
              "pm.test(\"details.message present\", () => pm.expect(pm.response.json().error.details.message).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/signup",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"weak@example.com\",\n  \"password\": \"short\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Signup bad body",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"error code invalid_request\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_request\"));",
              "pm.test(\"lists missing fields\", () => pm.expect(pm.response.json().error.details.fields).to.have.members([\"email\", \"password\"]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/signup",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Login wrong password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error code invalid_credentials\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_credentials\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/login",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Login unknown user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error code invalid_credentials\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_credentials\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/login",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nobody-here@example.com\",\n  \"password\": \"Passw0rd1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"signed in\", () => { pm.expect(b.signed_in).to.eql(true); pm.expect(b.email).to.eql(pm.collectionVariables.get(\"email\")); });",
              "pm.test(\"no Cognito tokens returned\", () => pm.expect(pm.response.text()).to.not.match(/token/i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/login",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Afterwards, check Windows Credential Manager for a `HiveMind` entry."
      }
    },
    {
      "name": "12 Session (signed in)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"signed in\", () => { pm.expect(b.signed_in).to.eql(true); pm.expect(b.email).to.eql(pm.collectionVariables.get(\"email\")); pm.expect(b.team).to.eql(null); pm.expect(b.relay).to.eql(\"disconnected\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/session",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "session"
          ]
        }
      }
    },
    {
      "name": "13 Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/logout",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      }
    },
    {
      "name": "14 Session (after logout)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"signed out\", () => pm.expect(pm.response.json().signed_in).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/session",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "session"
          ]
        }
      }
    },
    {
      "name": "15 Logout again is harmless",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/auth/logout",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      }
    },
    {
      "name": "16 Unknown path",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"error code not_found\", () => pm.expect(pm.response.json().error.code).to.eql(\"not_found\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{AGENT_URL}}/nope",
          "host": [
            "{{AGENT_URL}}"
          ],
          "path": [
            "nope"
          ]
        }
      }
    }
  ]
}
