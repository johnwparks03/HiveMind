# Copy to docs/e2e/.env (gitignored) and fill in. Used by docs/e2e/mine.py.
# Variables already set in the shell take precedence over this file.

# The sign-in of the person whose published files you want to list (their HiveMind account).
HIVEMIND_EMAIL=
HIVEMIND_PASSWORD=

# Optional. When left out, these are read from agent/.env (same names the agent uses):
# CDK output UserPoolClientId
# HIVEMIND_COGNITO_CLIENT_ID=
# CDK output HttpApiUrl
# HIVEMIND_CENTRAL_API_URL=
